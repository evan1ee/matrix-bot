{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id AS \"id!\", account_id AS \"account_id!\", event_type AS \"event_type!\", payload AS \"payload!\"\n        FROM (\n            SELECT id, account_id, event_type, payload FROM outbox_events\n            WHERE id > $1 AND account_id = ANY($2)\n            ORDER BY id DESC\n            LIMIT $3\n        ) newest\n        ORDER BY id\n        ",
