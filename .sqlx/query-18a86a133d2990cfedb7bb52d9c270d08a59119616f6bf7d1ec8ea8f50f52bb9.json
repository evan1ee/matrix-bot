  "query": "\n        SELECT\n            title,\n            COALESCE(search_text, content) AS \"text!\",\n            COALESCE(content_hash, encode(sha256(convert_to(content, 'UTF8')), 'hex')) AS \"content_hash!\",\n            indexed_content_hash\n        FROM notes\n        WHERE id = $1 AND owner_id = $2\n        ",
