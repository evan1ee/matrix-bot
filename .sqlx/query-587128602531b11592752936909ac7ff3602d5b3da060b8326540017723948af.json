  "query": "\n        SELECT text, priority, completed, created_at\n        FROM todos\n        WHERE owner_id = $1\n          AND date(due_at AT TIME ZONE $3)::text = $2\n          AND (created_at IS NULL OR date(created_at AT TIME ZONE $3)::text != $2)\n        ",
