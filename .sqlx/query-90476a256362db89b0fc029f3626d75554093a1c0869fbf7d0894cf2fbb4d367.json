  "db_name": "PostgreSQL",
  "query": "\n        SELECT l.target_note_id, COALESCE(t.title, l.target_title) AS \"title!\"\n        FROM knowledge_note_links l\n        LEFT JOIN notes t ON t.id = l.target_note_id\n        WHERE l.owner_id = $1 AND l.source_note_id = $2\n        ORDER BY l.id\n        ",
