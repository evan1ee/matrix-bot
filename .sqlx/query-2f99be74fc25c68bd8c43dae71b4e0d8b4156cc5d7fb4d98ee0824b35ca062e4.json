  "query": "\n        SELECT todo_id,\n               COUNT(*) FILTER (WHERE done) AS \"done!\",\n               COUNT(*) AS \"total!\"\n        FROM todo_steps WHERE todo_id = ANY($1) AND owner_id = $2\n        GROUP BY todo_id ORDER BY todo_id\n        ",
