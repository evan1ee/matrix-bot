{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT h.name AS habit_name, hl.note, hl.created_at\n        FROM habit_logs hl\n        JOIN habits h ON h.id = hl.habit_id\n        WHERE hl.owner_id = $1 AND hl.log_date = $2\n        ORDER BY hl.created_at\n        ",
