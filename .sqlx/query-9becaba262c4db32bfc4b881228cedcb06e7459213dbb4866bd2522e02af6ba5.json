  "db_name": "PostgreSQL",
  "query": "\n        SELECT currency, currency_exponent,\n               CAST(SUM(CASE WHEN direction = 'income' THEN amount_minor ELSE -amount_minor END) AS BIGINT) AS net_cash\n        FROM transactions\n        WHERE owner_id = $1\n        GROUP BY currency, currency_exponent\n        ",
