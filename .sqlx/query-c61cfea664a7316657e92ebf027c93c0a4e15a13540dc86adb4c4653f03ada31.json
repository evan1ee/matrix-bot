  "query": "\n        UPDATE scheduled_agent_tasks\n        SET enabled = $3,\n            next_run_at = COALESCE($4, next_run_at),\n            updated_at = $5\n        WHERE account_id = $1 AND task_id = $2\n        RETURNING\n            id, account_id, task_id, cron_expression, enabled,\n            config, last_run_at, next_run_at, created_at, updated_at\n        ",
