  "query": "\n        SELECT\n            COUNT(id) AS \"total_places!\",\n            COUNT(DISTINCT NULLIF(country, '')) AS \"total_countries!\",\n            COALESCE(CAST(SUM(stay_duration_days) AS BIGINT), 0) AS \"total_days_traveled!\"\n        FROM footprints\n        WHERE owner_id = $1\n        ",
