{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            spend_currency,\n            spend_currency_exponent,\n            COALESCE(CAST(SUM(spend_amount_minor) AS BIGINT), 0) AS \"total_spend_minor!\"\n        FROM footprints\n        WHERE owner_id = $1 AND spend_amount_minor > 0\n        GROUP BY spend_currency, spend_currency_exponent\n        ORDER BY 3 DESC\n        ",
