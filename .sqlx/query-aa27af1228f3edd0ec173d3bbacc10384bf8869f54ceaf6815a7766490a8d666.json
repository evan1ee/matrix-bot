  "query": "\n        INSERT INTO finance_shares (owner_id, token, is_enabled, title)\n        VALUES ($1, $2, $3, $4)\n        ON CONFLICT (owner_id)\n        DO UPDATE SET is_enabled = $3, title = $4, updated_at = NOW()\n        RETURNING owner_id, token, is_enabled, title, created_at, updated_at\n        ",
