  "query": "\n        INSERT INTO todo_steps (todo_id, owner_id, position, text, done)\n        SELECT $1, $2, COALESCE(MAX(position), 0) + 1, $3, FALSE\n        FROM todo_steps WHERE todo_id = $1\n        RETURNING id, todo_id, position, text, done\n        ",
