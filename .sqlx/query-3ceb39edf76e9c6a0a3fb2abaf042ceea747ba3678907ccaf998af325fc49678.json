  "query": "\n        SELECT id, room_id, owner_id, sender_name, text, priority, due_at, remind_before_minutes, completed, created_at\n        FROM todos\n        WHERE room_id = $1\n        ORDER BY completed ASC, id ASC\n        LIMIT $2 OFFSET $3\n        ",
