{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, room_id, owner_id, sender_name, text, priority, due_at, remind_before_minutes, completed, created_at\n        FROM todos\n        WHERE room_id = $1 AND owner_id = $2\n          AND ($3::boolean IS NULL OR completed = $3)\n        ORDER BY completed ASC, id DESC\n        LIMIT $4 OFFSET $5\n        ",
