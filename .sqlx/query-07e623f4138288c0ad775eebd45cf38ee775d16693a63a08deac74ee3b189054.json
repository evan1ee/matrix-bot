  "query": "\n        SELECT id, owner_id, symbol, target_price_minor, currency, currency_exponent,\n               condition, is_triggered, triggered_at, created_at\n        FROM portfolio_price_alerts\n        WHERE owner_id = $1\n        ORDER BY is_triggered ASC, created_at DESC\n        ",
