  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, conversation_id, role, content, tool_call_id, tool_name, created_at\n        FROM ai_messages\n        WHERE conversation_id = $1 AND (role != 'assistant' OR TRIM(content) != '')\n        ORDER BY created_at DESC\n        LIMIT $2\n        ",
