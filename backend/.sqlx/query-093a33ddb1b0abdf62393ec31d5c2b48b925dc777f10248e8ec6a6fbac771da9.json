{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, owner_id, title, content, format, source_channel, source_ref,\n            tags, is_archived, created_at, updated_at\n        FROM notes\n        WHERE owner_id = $1\n          AND ($2::TEXT IS NULL OR $2 = ANY(tags))\n          AND ($3::BOOLEAN OR is_archived = FALSE)\n        ORDER BY updated_at DESC\n        LIMIT $4\n        ",
