{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id, room_id, owner_id, sender_name, message, trigger_at,\n                recurrence, status, retry_count, source_kind, source_id, created_at\n            FROM reminders\n            WHERE owner_id = $1\n              AND ($2::text IS NULL OR room_id = $2)\n              AND status = 'pending'\n            ORDER BY trigger_at ASC\n            LIMIT $3 OFFSET $4\n            ",
