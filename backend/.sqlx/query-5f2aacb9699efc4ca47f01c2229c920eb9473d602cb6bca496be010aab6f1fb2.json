  "query": "\n        SELECT\n            COUNT(*) as \"total!\",\n            COUNT(*) FILTER (WHERE is_archived = FALSE) as \"unread!\",\n            COUNT(*) FILTER (WHERE is_archived = TRUE) as \"archived!\",\n            COUNT(*) FILTER (WHERE is_favorite = TRUE) as \"favorite!\"\n        FROM bookmarks\n        WHERE owner_id = $1\n        ",
