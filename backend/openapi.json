              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "error": {
            "type": "string"
          }
        }
      },
      "AuthPayload": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "token_type",
          "username"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "CreateReminderRequest": {
        "type": "object",
        "required": [
          "message",
          "seconds"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "recurrence": {
            "type": "string",
            "nullable": true
          },
          "room_id": {
            "type": "string",
            "nullable": true
          },
          "seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "CreateTodoRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "priority": {
            "type": "string",
            "nullable": true
          },
          "room_id": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "db_status"
        ],
        "properties": {
          "db_status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "MediaProxyQuery": {
        "type": "object",
        "required": [
          "server",
          "media_id"
        ],
        "properties": {
          "media_id": {
            "type": "string"
          },
          "server": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RecurrencePattern": {
        "type": "string",
        "description": "Pattern for recurring reminders (none, daily, or weekly).",
        "enum": [
          "None",
          "Daily",
          "Weekly"
        ]
      },
      "RegisterPayload": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Reminder": {
        "type": "object",
        "description": "A reminder stored in the database.",
        "required": [
          "id",
          "room_id",
          "sender_mxid",
          "sender_name",
          "message",
          "trigger_at",
          "recurrence",
          "status",
          "retry_count"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          },
          "recurrence": {
            "type": "string"
          },
          "retry_count": {
            "type": "integer",
            "format": "int64"
          },
          "room_id": {
            "type": "string"
          },
          "sender_mxid": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "trigger_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReminderListResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reminder"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ReminderQuery": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "page": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "room_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ReminderStatus": {
        "type": "string",
        "description": "Status of a reminder in the database.",
        "enum": [
          "Pending",
          "Triggered",
          "Cancelled",
          "Failed"
        ]
      },
      "TodoItem": {
        "type": "object",
        "required": [
          "id",
          "room_id",
          "sender_mxid",
          "sender_name",
          "text",
          "priority",
          "completed"
        ],
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "due_at": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "priority": {
            "type": "string"
          },
          "room_id": {
            "type": "string"
          },
          "sender_mxid": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "TodoListResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TodoItem"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "TodoPriority": {
        "type": "string",
        "enum": [
          "Low",
          "Medium",
          "High"
        ]
      },
      "TodoQuery": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "page": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "room_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UpdateTodoRequest": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "boolean",
            "nullable": true
          },
          "due_at": {
            "type": "string",
            "nullable": true
          },
          "priority": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UserProfileResponse": {
        "type": "object",
        "required": [
          "username"
        ],
        "properties": {
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "display_name": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Matrix Bot REST API",
      "description": "REST API & Real-time Web interface endpoints"
    }
  ]
}