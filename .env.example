# Matrix Bot Configuration

# The URL of your Matrix homeserver (e.g. https://matrix.org or https://mbm.one)
MATRIX_HOMESERVER=https://matrix.org

# Bot login credential (username or full Matrix User ID e.g. @bot:matrix.org)
MATRIX_USERNAME=your_bot_username

# Bot password
MATRIX_PASSWORD=your_bot_password

# Optional: Matrix Security Recovery Key (used to auto-verify device session in
# E2EE rooms). Without it a fresh crypto store has no room keys, so the bot
# cannot decrypt messages sent before its current device existed.
# MATRIX_RECOVERY_KEY="Es4T xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx"

# Optional: users allowed to complete an interactive verification with the bot.
# The bot auto-confirms the SAS emoji (nobody is watching on its side), so
# anyone listed here becomes trusted by the bot — keep it to accounts you own.
# The bot's own account is always permitted. Comma-separated MXIDs.
MATRIX_VERIFICATION_ALLOWLIST=

# Database connection URL. SQLite or PostgreSQL; the scheme decides which.
#
# SQLite is the default and needs no server — it is what the standalone binary
# and `docker run` with a volume use. Point this at PostgreSQL instead and the
# same schema is created there on boot:
#
#   DATABASE_URL=postgres://user:password@localhost:5432/matrix_bot
#
# Nothing else changes: every feature works against either. See
# docs/POSTGRES_MIGRATION.md for what differs underneath.
DATABASE_URL=sqlite://data/bot_data.db?mode=rwc

# Maximum pooled database connections (default: 10). Means the same on both.
DATABASE_MAX_CONNECTIONS=10

# Embedded REST API & Web Server Host (default: 0.0.0.0)
API_HOST=0.0.0.0

# Embedded REST API & Web Server Port (default: 8080)
API_PORT=8080


# Optional Secret to gate /api/v1/auth/register endpoint (uncomment to require secret for registration)
# API_REGISTRATION_SECRET=my_registration_secret_key

# Comma-separated origins allowed to call the API cross-origin.
# Leave unset for same-origin only — the bundled SPA is served by this server and
# the Vite dev server proxies /api, so neither needs an entry here.
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173

# Log level (info, debug, warn, error)
RUST_LOG=info,matrix_bot=debug,matrix_sdk=info

# --- Web sign-in (WebAuthn / passkeys) ---------------------------------------
# RP ID is a bare HOSTNAME: no scheme, no port. It is baked into every passkey
# at creation — changing it invalidates every passkey ever registered.
# Ports are NOT part of it, so one value of `localhost` covers both the Vite dev
# server (:5173) and the API (:8080).
WEBAUTHN_RP_ID=localhost

# The full origin the BROWSER loads the page from, port included. This is also
# what every state-changing request's `Origin` header is checked against, so it
# must be where you actually browse:
#   using `npm run dev`  -> http://localhost:5173
#   hitting the API directly -> http://localhost:8080
WEBAUTHN_ORIGIN=http://localhost:5173

# Production (uncomment and set to your real subdomain; the app refuses to boot
# in production while these are still the localhost defaults):
# WEBAUTHN_RP_ID=bot.example.com
# WEBAUTHN_ORIGIN=https://bot.example.com

# --- AI Assistant Configuration ----------------------------------------------
# Default AI Endpoint (OpenAI-compatible)
# Standard OpenAI: https://api.openai.com/v1
# xAI / Grok:     https://api.x.ai/v1
# Ollama local:   http://localhost:11434/v1
# LM Studio:      http://localhost:1234/v1
# DeepSeek:       https://api.deepseek.com/v1
AI_ENDPOINT=https://api.x.ai/v1
# AI_API_BASE=https://api.x.ai/v1

# API Key for the AI provider (e.g. xai-..., sk-proj-...)
AI_API_KEY=

# Default model name (e.g. grok-4.6, grok-2-1212, gpt-4o-mini, deepseek-chat)
AI_MODEL=grok-4.6

# Optional HTTP/HTTPS proxy for AI requests (e.g. http://127.0.0.1:7897)
# AI_PROXY=http://127.0.0.1:7897

# Default user settings
# DEFAULT_TIMEZONE=Asia/Shanghai
# DEFAULT_CURRENCY=CNY

ENVIRONMENT=development

COOKIE_SECURE=false


# Live web search via Tavily API (optional, falls back to DuckDuckGo if unset)
# https://app.tavily.com/
TAVILY_API_KEY=

# --- OCR Feature (via matrix-bot-inference HTTP service) --------------------
# Enable/disable image OCR text extraction in Matrix chat (default: true)
OCR_ENABLED=true
# Base URL of the inference server that runs OCR. Read by the bot. Leave this
# commented out to run without OCR: image messages then answer with a message
# saying so, and nothing else is affected.
#
# Under `docker compose up`, OCR_BASE_URL is unnecessary: docker-compose.yml
# supplies its own default (http://inference:8090, the inference service's
# name on the compose network) whenever this variable is unset here. To
# switch OCR off under compose instead of leaving it unset, set it to an
# explicitly empty value here (OCR_BASE_URL=) -- the bot reads empty as "not
# configured", the same as leaving it commented out for `docker run`.
# Uncomment only for `docker run` / systemd deployments that also run their
# own inference server reachable at a real address:
# OCR_BASE_URL=http://inference:8090

# Read by the inference container, not the bot. Directory where OCR models
# are downloaded at inference-server startup.
OCR_MODEL_DIR=/app/data/ocr_models

# --- Voice Transcription (OpenAI-compatible speech-to-text) -------------------
# Enable/disable voice transcription (default: true). This gates ONLY the web
# API's POST /api/v1/voice/transcribe endpoint. It does NOT gate the Matrix
# path: an m.audio message in a Matrix room is transcribed whenever
# STT_BASE_URL resolves to something, regardless of this flag.
VOICE_ENABLED=true
# Language hint sent with each request (default: auto). The bundled server
# accepts exactly: auto, zh, en, ja, ko, yue. A hosted provider instead
# expects a plain ISO-639-1 code (e.g. en, zh, ja) and is not limited to that
# list. "auto" is never sent either way -- the provider detects the language.
VOICE_LANGUAGE=auto

# Base URL of an OpenAI-compatible speech-to-text API, INCLUDING its /v1
# prefix. Read by the bot. Leave commented out to run without transcription:
# voice notes then answer with a message saying so, and nothing else changes.
# Under `docker compose up`, to switch transcription off instead of leaving it
# unset, set it to an explicitly empty value here (STT_BASE_URL=) -- the bot
# reads empty as "not configured", the same as leaving it commented out. The
# same applies to OCR_BASE_URL above.
#
# Under `docker compose up` this is unnecessary: docker-compose.yml defaults
# it to the bundled inference server (http://inference:8090/v1). Set it to use
# a hosted provider instead -- STT_MODEL must also be set, since its default
# (sensevoice-small) is a name only the bundled server accepts:
#   STT_BASE_URL=https://api.openai.com/v1       STT_MODEL=gpt-4o-mini-transcribe
#   STT_BASE_URL=https://api.openai.com/v1       STT_MODEL=whisper-1
#   STT_BASE_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3
# STT_BASE_URL=http://inference:8090/v1
# Bearer token for a hosted provider. The bundled server needs none.
# STT_API_KEY=
# Model name sent with each request (default: sensevoice-small, which the
# bundled server ignores -- it has exactly one model). Required for a hosted
# provider; see the examples above.
# STT_MODEL=sensevoice-small

# Read by the inference container, not the bot. Directory the SenseVoice model
# is downloaded into at inference-server startup.
VOICE_MODEL_DIR=/app/data/voice_models

# --- Text-to-Speech (!say voice replies) --------------------------------------
# Base URL of a text-to-speech API, INCLUDING its /v1 prefix. Read by the bot.
# Leave commented out to run without !say (it then answers that speech is
# unavailable, and nothing else changes). Under `docker compose up` this
# defaults to the bundled inference server's Kokoro (http://inference:8090/v1);
# set it to an explicitly empty value (TTS_BASE_URL=) to switch !say off.
#
# Hosted providers -- set the URL, key, model and voice together:
#   OpenAI:     TTS_BASE_URL=https://api.openai.com/v1      TTS_MODEL=tts-1  TTS_VOICE=alloy
#   ElevenLabs: TTS_BASE_URL=https://api.elevenlabs.io/v1   TTS_DIALECT=elevenlabs
#               TTS_MODEL=eleven_multilingual_v2             TTS_VOICE=<voice id>
# TTS_BASE_URL=http://inference:8090/v1
# Bearer token (OpenAI dialect) or xi-api-key (ElevenLabs). The bundled server needs none.
# TTS_API_KEY=
# Model name sent with each request (default: kokoro, which the bundled server ignores).
# TTS_MODEL=kokoro
# House default voice for anyone who never chose one: a Kokoro speaker id
# (0-102) for the bundled server, otherwise a name or id your provider knows.
# Each user can override it with `!settings voice <voice>` or in the web
# Settings modal; `!settings voice none` returns them to this default.
# TTS_VOICE=0
# openai (default) or elevenlabs. The bot refuses to start on anything else.
# TTS_DIALECT=openai

# Read by the inference container, not the bot. Directory the Kokoro model
# (365 MB download) is unpacked into at inference-server startup.
TTS_MODEL_DIR=/app/data/tts_models/kokoro-multi-lang-v1_1
