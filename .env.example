# Matrix Bot Configuration

# The URL of your Matrix homeserver (e.g. https://matrix.org or https://mbm.one)
MATRIX_HOMESERVER=https://matrix.org

# Bot login credential (username or full Matrix User ID e.g. @bot:matrix.org)
MATRIX_USERNAME=your_bot_username

# Bot password
MATRIX_PASSWORD=your_bot_password

# Optional: Matrix Security Recovery Key (used to auto-verify device session in E2EE rooms)
# MATRIX_RECOVERY_KEY="Es4T xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx"

# Database connection URL (defaults to data/bot_data.db)
DATABASE_URL=sqlite://data/bot_data.db?mode=rwc

# Log level (info, debug, warn, error)
RUST_LOG=info,matrix_bot=debug,matrix_sdk=info
